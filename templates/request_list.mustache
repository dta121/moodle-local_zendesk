<div class="local-zendesk-request-list">
    <div class="mb-3 d-flex flex-wrap align-items-center">
        <a class="btn btn-primary mr-2 mb-2" href="{{newrequesturl}}">{{newrequestlabel}}</a>
        {{#hashelpcenterlink}}
        <a class="btn btn-outline-secondary mb-2" href="{{helpcenterurl}}">{{helpcenterlabel}}</a>
        {{/hashelpcenterlink}}
    </div>

    {{#requests}}
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div class="mr-3">
                    <h5 class="card-title mb-1">
                        <a href="{{viewurl}}">{{subject}}</a>
                    </h5>
                    {{#hascourse}}
                    <div class="text-muted small">{{coursefullname}}</div>
                    {{/hascourse}}
                </div>
                <span class="{{statusclass}}">{{statuslabel}}</span>
            </div>
            <div class="text-muted small mt-2">{{createdlabel}} {{timecreatedhuman}} &middot; {{updatedlabel}} {{timemodifiedhuman}}</div>
            <p class="mt-3 mb-0">{{bodyexcerpt}}</p>
        </div>
    </div>
    {{/requests}}

    {{^requests}}
    <div class="alert alert-info">{{emptylabel}}</div>
    {{/requests}}
</div>
