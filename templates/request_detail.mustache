  @template local_zendesk/request_detail

  Example context (json):
  {
    "backurl": "#",
    "backlabel": "Back to requests",
    "hashelpcenterlink": true,
    "helpcenterurl": "#",
    "helpcenterlabel": "Open Help Center",
    "statusclass": "badge badge-info",
    "statuslabel": "Open",
    "supportreplyinitial": "HD",
    "conversationeyebrow": "Zendesk support thread",
    "subject": "Testing Plugin for Moodle",
    "messagesubtitle": "Your conversation with the help desk stays here in Moodle.",
    "hascourse": true,
    "coursefullname": "Student Success 101",
    "createdlabel": "Created",
    "updatedlabel": "Updated",
    "timecreatedhuman": "April 9, 2026, 10:00 AM",
    "timemodifiedhuman": "April 9, 2026, 12:00 PM",
    "haszendeskticketid": true,
    "requestnumberlabel": "Zendesk ticket",
    "zendeskticketid": 42,
    "messageheading": "Your message",
    "repliesheading": "Conversation",
    "messageauthorinitial": "ME",
    "messageauthorlabel": "You",
    "hasbodyhtml": true,
    "bodyhtml": "<p>Hello support team.</p>",
    "haspublicreplies": true,
    "publicreplies": [
      {
        "messageclass": "local-zendesk-chat__message local-zendesk-chat__message--support",
        "avatarclass": "local-zendesk-chat__avatar--support",
        "authorinitial": "HD",
        "authorlabel": "Help desk",
        "createdhuman": "April 9, 2026, 12:00 PM",
        "bubbleclass": "local-zendesk-chat__bubble local-zendesk-chat__bubble--support",
        "hasbodyhtml": true,
        "bodyhtml": "<p>We can help with that.</p>",
        "hasattachments": false
      }
    ],
    "hasreplyformhtml": false
  }
}}

<div class="local-zendesk-chat">
    <section class="local-zendesk-chat__hero">
        <div class="local-zendesk-chat__toolbar">
            <a class="local-zendesk-chat__back" href="{{backurl}}">{{backlabel}}</a>
            <div class="local-zendesk-chat__toolbar-actions">
                {{#hashelpcenterlink}}
                <a class="local-zendesk-chat__helpcenter" href="{{helpcenterurl}}">{{helpcenterlabel}}</a>
                {{/hashelpcenterlink}}
                <span class="local-zendesk-chat__status {{statusclass}}">{{statuslabel}}</span>
            </div>
        </div>

        <div class="local-zendesk-chat__hero-main">
            <div class="local-zendesk-chat__hero-avatar">{{supportreplyinitial}}</div>
            <div class="local-zendesk-chat__hero-copy">
                <div class="local-zendesk-chat__eyebrow">{{conversationeyebrow}}</div>
                <h2 class="local-zendesk-chat__title">{{subject}}</h2>
                <p class="local-zendesk-chat__subtitle">{{messagesubtitle}}</p>
                {{#hascourse}}
                <div class="local-zendesk-chat__context">{{coursefullname}}</div>
                {{/hascourse}}
            </div>
        </div>

        <div class="local-zendesk-chat__meta {{#haszendeskticketid}}local-zendesk-chat__meta--has-ticket{{/haszendeskticketid}}{{^haszendeskticketid}}local-zendesk-chat__meta--two-up{{/haszendeskticketid}}">
            <div class="local-zendesk-chat__meta-chip local-zendesk-chat__meta-chip--created">
                <span>{{createdlabel}}</span>
                <strong>{{timecreatedhuman}}</strong>
            </div>
            <div class="local-zendesk-chat__meta-chip local-zendesk-chat__meta-chip--updated">
                <span>{{updatedlabel}}</span>
                <strong>{{timemodifiedhuman}}</strong>
            </div>
            {{#haszendeskticketid}}
            <div class="local-zendesk-chat__meta-chip local-zendesk-chat__meta-chip--ticket">
                <span>{{requestnumberlabel}}</span>
                <strong>#{{zendeskticketid}}</strong>
            </div>
            {{/haszendeskticketid}}
        </div>

        {{#haserror}}
        <div class="alert alert-warning local-zendesk-chat__warning">{{submissionerror}}</div>
        {{/haserror}}
    </section>

    <section class="local-zendesk-chat__thread-card">
        <div class="local-zendesk-chat__thread-head">
            <div>
                <div class="local-zendesk-chat__thread-eyebrow">{{messageheading}}</div>
                <h3 class="local-zendesk-chat__thread-title">{{repliesheading}}</h3>
            </div>
            <span class="local-zendesk-chat__thread-status {{statusclass}}">{{statuslabel}}</span>
        </div>

        <div class="local-zendesk-chat__messages">
            {{#hasbodyhtml}}
            <article class="local-zendesk-chat__message local-zendesk-chat__message--student local-zendesk-chat__message--origin">
                <div class="local-zendesk-chat__message-meta">
                    <span class="local-zendesk-chat__avatar local-zendesk-chat__avatar--student">{{messageauthorinitial}}</span>
                    <span class="local-zendesk-chat__author">{{messageauthorlabel}}</span>
                    <span class="local-zendesk-chat__timestamp">{{timecreatedhuman}}</span>
                </div>
                <div class="local-zendesk-chat__bubble local-zendesk-chat__bubble--student">
                    {{{bodyhtml}}}
                </div>
            </article>
            {{/hasbodyhtml}}

            {{#haspublicreplies}}
            {{#publicreplies}}
            <article class="local-zendesk-chat__message {{messageclass}}">
                <div class="local-zendesk-chat__message-meta">
                    <span class="local-zendesk-chat__avatar {{avatarclass}}">{{authorinitial}}</span>
                    <span class="local-zendesk-chat__author">{{authorlabel}}</span>
                    <span class="local-zendesk-chat__timestamp">{{createdhuman}}</span>
                </div>
                <div class="local-zendesk-chat__bubble {{bubbleclass}}">
                    {{#hasbodyhtml}}
                    {{{bodyhtml}}}
                    {{/hasbodyhtml}}

                    {{#hasattachments}}
                    <div class="local-zendesk-chat__attachments">
                        {{#attachments}}
                        <a class="local-zendesk-chat__attachment {{#isimage}}local-zendesk-chat__attachment--image{{/isimage}}{{^isimage}}local-zendesk-chat__attachment--file{{/isimage}}"
                            href="{{downloadurl}}" target="_blank" rel="noopener noreferrer">
                            {{#isimage}}
                            <img class="local-zendesk-chat__attachment-preview" src="{{previewurl}}" alt="{{filename}}">
                            {{/isimage}}
                            <span class="local-zendesk-chat__attachment-name">{{filename}}</span>
                            {{#hasfilesize}}
                            <span class="local-zendesk-chat__attachment-size">{{filesizehuman}}</span>
                            {{/hasfilesize}}
                        </a>
                        {{/attachments}}
                    </div>
                    {{/hasattachments}}
                </div>
            </article>
            {{/publicreplies}}
            {{/haspublicreplies}}

            {{#hasreplyloaderror}}
            <div class="alert alert-warning local-zendesk-chat__inline-warning">{{replyloaderror}}</div>
            {{/hasreplyloaderror}}

            {{^haspublicreplies}}
            {{^hasreplyloaderror}}
            <div class="local-zendesk-chat__empty-state">{{norepliesyet}}</div>
            {{/hasreplyloaderror}}
            {{/haspublicreplies}}
        </div>
    </section>

    {{#hasreplyformhtml}}
    <section class="local-zendesk-chat__composer">
        <div class="local-zendesk-chat__composer-copy">
            <div class="local-zendesk-chat__composer-eyebrow">{{replyheading}}</div>
            <p class="local-zendesk-chat__composer-help">{{replyhelptext}}</p>
        </div>
        <div class="local-zendesk-chat__composer-form">
            {{{replyformhtml}}}
        </div>
    </section>
    {{/hasreplyformhtml}}
</div>
