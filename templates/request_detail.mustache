<div class="local-zendesk-request-detail">
    <div class="mb-3">
        <a class="btn btn-secondary" href="{{backurl}}">{{backlabel}}</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div class="mr-3">
                    <h4 class="card-title mb-1">{{subject}}</h4>
                    {{#hascourse}}
                    <div class="text-muted small">{{coursefullname}}</div>
                    {{/hascourse}}
                </div>
                <span class="{{statusclass}}">{{statuslabel}}</span>
            </div>

            <dl class="row mt-3">
                <dt class="col-sm-3">{{createdlabel}}</dt>
                <dd class="col-sm-9">{{timecreatedhuman}}</dd>

                <dt class="col-sm-3">{{updatedlabel}}</dt>
                <dd class="col-sm-9">{{timemodifiedhuman}}</dd>

                {{#haszendeskticketid}}
                <dt class="col-sm-3">{{requestnumberlabel}}</dt>
                <dd class="col-sm-9">{{zendeskticketid}}</dd>
                {{/haszendeskticketid}}
            </dl>

            {{#haserror}}
            <div class="alert alert-warning">{{submissionerror}}</div>
            {{/haserror}}

            {{#hasbodyhtml}}
            <h5 class="mt-4">{{messageheading}}</h5>
            <div class="border rounded p-3 mt-3">
                {{{bodyhtml}}}
            </div>
            {{/hasbodyhtml}}

            <h5 class="mt-4">{{repliesheading}}</h5>

            {{#haspublicreplies}}
            {{#publicreplies}}
            <div class="border rounded p-3 mt-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                    <strong>{{authorlabel}}</strong>
                    <span class="text-muted small">{{createdhuman}}</span>
                </div>
                {{{bodyhtml}}}
            </div>
            {{/publicreplies}}
            {{/haspublicreplies}}

            {{#hasreplyloaderror}}
            <div class="alert alert-warning mt-3">{{replyloaderror}}</div>
            {{/hasreplyloaderror}}

            {{^haspublicreplies}}
            {{^hasreplyloaderror}}
            <div class="text-muted mt-3">{{norepliesyet}}</div>
            {{/hasreplyloaderror}}
            {{/haspublicreplies}}
        </div>
    </div>
</div>
