  @template local_zendesk/sso_redirect

  Example context (json):
  {
    "heading": "Opening Zendesk Help Center",
    "body": "You are being signed into Zendesk with your Moodle account.",
    "formaction": "https://example.zendesk.com/access/jwt",
    "jwt": "header.payload.signature",
    "hasreturnto": true,
    "returnto": "/hc/en-us/requests",
    "submitlabel": "Continue to Zendesk"
  }
}}

<div class="local-zendesk-sso-redirect text-center py-4">
    <h2 class="h4 mb-3">{{heading}}</h2>
    <p class="text-muted mb-4">{{body}}</p>

    <form id="local-zendesk-sso-redirect-form" action="{{formaction}}" method="post">
        <input type="hidden" name="jwt" value="{{jwt}}">
        {{#hasreturnto}}
        <input type="hidden" name="return_to" value="{{returnto}}">
        {{/hasreturnto}}

        <noscript>
            <button type="submit" class="btn btn-primary">{{submitlabel}}</button>
        </noscript>
    </form>
</div>

{{#js}}
document.getElementById('local-zendesk-sso-redirect-form').submit();
{{/js}}
